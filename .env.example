# ---- Application ----
APP_ENV=production
PORT=8080

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=splitbill
DB_PASSWORD=splitbill
DB_NAME=splitbill
DB_SSLMODE=disable

# ---- OCR Service ----
# URL for the API to reach the OCR service (use http://ocr:8090 inside compose)
OCR_SERVICE_URL=http://localhost:8090
OCR_PORT=8090
OCR_LANG=eng+ind

# ---- Auth / Session ----
JWT_SECRET=change-me-in-production
SESSION_TTL_MINUTES=1440

# ---- Upload ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# ---- Misc ----
RATE_LIMIT_PER_MINUTE=300
ALLOWED_ORIGINS=*
SHUTDOWN_TIMEOUT_SECONDS=10
